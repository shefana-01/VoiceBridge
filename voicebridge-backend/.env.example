# VoiceBridge — local development environment variables
# Copy this to .env and fill in your values. Never commit .env to Git.

SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL database — create this DB in pgAdmin first
DB_NAME=voicebridge_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Media files storage path (relative to backend root)
MEDIA_ROOT=media

# Max file upload size in MB (images: 5 MB, audio: 3 MB enforced at model level)
MAX_UPLOAD_SIZE_MB=10

# React admin panel origin (Vite default port)
CORS_ALLOWED_ORIGINS=http://localhost:5173
