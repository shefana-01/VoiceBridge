<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#66FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/glass_border"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_board_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Board Name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#0B1C30"/>

        <TextView
            android:id="@+id/tv_board_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4 × 4 grid"
            android:textSize="13sp"
            android:textColor="#52625D"
            android:layout_marginTop="4dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
