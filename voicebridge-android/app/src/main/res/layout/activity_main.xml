<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp"
    android:background="@drawable/bg_atmospheric"
    android:keepScreenOn="true">

    <!-- Settings & Toggles Row -->
    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@android:drawable/ic_menu_preferences"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Settings"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Switch
        android:id="@+id/toggle_high_contrast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HC"
        android:textSize="12sp"
        android:textColor="@color/ink_soft"
        app:layout_constraintTop_toTopOf="@id/btn_settings"
        app:layout_constraintBottom_toBottomOf="@id/btn_settings"
        app:layout_constraintStart_toEndOf="@id/btn_settings"
        android:layout_marginStart="8dp" />

    <Switch
        android:id="@+id/toggle_switch_focus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SF"
        android:textSize="12sp"
        android:textColor="@color/ink_soft"
        app:layout_constraintTop_toTopOf="@id/btn_settings"
        app:layout_constraintBottom_toBottomOf="@id/btn_settings"
        app:layout_constraintStart_toEndOf="@id/toggle_high_contrast"
        android:layout_marginStart="8dp" />

    <ImageButton
        android:id="@+id/btn_clear_strip"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="@id/btn_settings"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Sentence Strip & Speak Button Row -->
    <FrameLayout
        android:id="@+id/strip_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/glass_border"
        android:backgroundTint="#66FFFFFF"
        android:padding="6dp"
        android:minHeight="64dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btn_settings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_speak"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tv_strip_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Tap to start"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sentence_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            android:clipToPadding="false"
            android:paddingStart="2dp"
            android:paddingEnd="2dp" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_speak"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="Speak"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:icon="@android:drawable/ic_lock_silent_mode_off"
        app:iconGravity="textStart"
        app:iconTint="@android:color/white"
        app:cornerRadius="16dp"
        android:backgroundTint="@color/colorPrimary"
        android:textColor="@android:color/white"
        android:alpha="0.4"
        android:enabled="false"
        app:layout_constraintTop_toTopOf="@id/strip_container"
        app:layout_constraintBottom_toBottomOf="@id/strip_container"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_board_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="@color/ink_soft"
        android:padding="2dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/strip_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ============ ICON GRID ============ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_icons"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/tv_board_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
